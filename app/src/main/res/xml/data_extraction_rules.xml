<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 关闭云备份与设备迁移：QAlbum 包含敏感的本地图片索引，
         不能跟随云端账号同步到其他设备 -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
